# Bot configuration template. Copy to .env (gitignored) and fill in.
# NEVER commit real values — the repo is public.

# demo | live  (demo -> api-demo.bybit.com; live key must be IP-whitelisted to the VPS)
BOT_CONTOUR=demo

# Bybit API key (trade-only permission, NO withdrawals)
BOT_BYBIT_API_KEY=your-api-key-here
BOT_BYBIT_API_SECRET=your-api-secret-here

# Telegram notifications (leave empty for log-only)
BOT_TELEGRAM_TOKEN=123456:your-bot-token-here
BOT_TELEGRAM_CHAT_ID=your-chat-id-here

# Data directory (journal.sqlite, bot.log, lock file)
BOT_DATA_DIR=data

# Per-strategy mode: off | paper | live
BOT_LIQREV_MODE=paper
BOT_UNLOCK_MODE=paper

# Equity basis for paper-mode sizing
BOT_PAPER_EQUITY_USD=5000

# Overlay slot-weight cap (audit defect 1): 1.0 = safety default; 2.0 = the uncapped research overlay
BOT_MAX_WEIGHT=1.0
# Portfolio gross cap: abs(open+pending) notional <= mult * (1 - buffer) * equity (audit defect 1)
BOT_GROSS_CAP_MULT=1.0
BOT_GROSS_SAFETY_BUFFER=0.05

BOT_LOG_LEVEL=INFO
